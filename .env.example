# Copy to .env to override defaults. All settings are prefixed FEEDWATCH_.
FEEDWATCH_KAFKA_BOOTSTRAP=localhost:29092
FEEDWATCH_DATABASE_URL=postgresql://feedwatch:feedwatch@localhost:55432/feedwatch
# Keep every raw exchange message in data/raw for later replay:
FEEDWATCH_RECORD_RAW=false
# Thresholds (see docs/detection-rules.md), e.g.:
FEEDWATCH_THRESHOLDS__DEPEG_WARN_PCT=0.5
FEEDWATCH_THRESHOLDS__SILENT_AFTER_S=10
